{
  "name": "@bher/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:check": "bun run src/check.ts",
    "db:migrate": "bun run src/migrate.ts",
    "db:migration:check": "drizzle-kit check --config=drizzle.config.ts",
    "test:integration": "bun test src/integration.test.ts",
    "test:unit": "bun test src/env.test.ts src/schema/auth.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "drizzle-orm": "0.45.2"
  }
}

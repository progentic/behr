# API listener port.
API_PORT=3000

# PostgreSQL connection used by BeHR's Bun SQL client.
DATABASE_URL=postgresql://behr_app:replace-with-local-password@localhost:5432/behr

# Public origin serving the Better Auth-backed API.
BETTER_AUTH_URL=http://localhost:3000

# Generate a high-entropy value of at least 32 characters. Never commit it.
BETTER_AUTH_SECRET=

# Exact browser origin allowed to send credentialed admin requests.
ADMIN_ORIGIN=http://localhost:3000

# One-time initial identity bootstrap inputs. No defaults are provided.
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

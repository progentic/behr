{
  "name": "bher-cms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "auth:bootstrap": "bun run --cwd apps/api auth:bootstrap",
    "db:check": "bun run --cwd packages/db db:check",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:migration:check": "bun run --cwd packages/db db:migration:check",
    "dev": "bun run --cwd apps/api dev",
    "dev:api-only": "bun run --cwd apps/api dev:api-only",
    "dev:admin-only": "bun run --cwd apps/admin dev",
    "dev:web": "bun run --cwd apps/web dev",
    "test": "bun run --cwd apps/api test && bun run --cwd packages/db test:unit",
    "test:auth:integration": "bun run --cwd apps/api test:auth:integration",
    "test:integration": "bun run --cwd packages/db test:integration",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}

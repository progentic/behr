{
  "name": "@bher/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/development.ts",
    "dev:api-only": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "auth:bootstrap": "bun run src/bootstrap.ts",
    "start": "bun run dist/index.js",
    "test": "bun test src/index.test.ts src/development.test.ts src/env.test.ts src/bootstrap.test.ts src/tenant-contract.test.ts src/site-contract.test.ts src/membership-contract.test.ts src/middleware/auth.test.ts src/routes/auth.test.ts src/routes/index.test.ts",
    "test:auth:integration": "bun test src/auth.integration.test.ts",
    "test:tenant:integration": "bun test src/tenant.integration.test.ts",
    "test:site:integration": "bun test src/site.integration.test.ts",
    "test:membership:integration": "bun test src/membership.integration.test.ts",
    "test:page:integration": "bun test src/page.integration.test.ts",
    "test:public:integration": "bun test src/public.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bher/contracts": "workspace:0.1.0",
    "@bher/db": "workspace:0.1.0",
    "better-auth": "1.7.2",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
